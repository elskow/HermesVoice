# Development defaults only. NEVER put real credentials here.
# Production creds are provisioned into NVS at manufacturing/flash time
# (see components/node_config). These values are compile-time fallbacks.
CONFIG_NODE_WIFI_SSID="NodeDev"
CONFIG_NODE_WIFI_PASS=""
CONFIG_NODE_MQTT_URI="mqtt://192.168.1.10:1883"
CONFIG_NODE_DEVICE_ID="node-01"
CONFIG_NODE_GATEWAY_URL="http://192.168.1.10:8081"
CONFIG_NODE_TELEMETRY_INTERVAL_S=30
CONFIG_NODE_PTT_GPIO=4
CONFIG_NODE_PTT_ACTIVE_LOW=y
CONFIG_NODE_MIC_WS_GPIO=25
CONFIG_NODE_MIC_SCK_GPIO=26
CONFIG_NODE_MIC_SD_GPIO=32
CONFIG_NODE_LED_GPIO=2
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_BLE_ONLY=y
