package web

templ Layout(title string, active string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · relay</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23161616'/%3E%3Crect x='3' y='3' width='10' height='3' fill='%230f62fe'/%3E%3Crect x='3' y='7' width='7' height='3' fill='%23f4f4f4'/%3E%3C/svg%3E"/>
			<style>
				:root {
					--bg: #f4f4f4;
					--surface: #ffffff;
					--border: #e0e0e0;
					--text: #161616;
					--text-2: #525252;
					--link: #0f62fe;
					--btn: #0f62fe;
					--btn-hover: #0353e9;
					--ok-bg: #defbe6;
					--ok-fg: #0e6027;
					--err-bg: #fff1f1;
					--err-fg: #a2191f;
					--tag-ok: #198038;
					--tag-err: #da1e28;
				}
				* { box-sizing: border-box; }
				body { font-family: "IBM Plex Sans", -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); font-size: 0.875rem; line-height: 1.4; margin: 0; }
				header.top { background: var(--text); color: #f4f4f4; padding: 0 1rem; height: 3rem; display: flex; align-items: center; gap: 1.5rem; }
				header.top .brand { font-weight: 600; color: #f4f4f4; text-decoration: none; }
				header.top nav a { color: #c6c6c6; text-decoration: none; margin-right: 1rem; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
				header.top nav a:hover { color: #fff; }
				header.top nav a[aria-current="page"] { color: #fff; border-bottom-color: var(--link); }
				main { max-width: 768px; margin: 0 auto; padding: 2rem 1rem; }
				h1 { font-size: 1.75rem; font-weight: 400; margin: 0 0 1.5rem; }
				h2 { font-size: 1rem; font-weight: 600; margin: 1.5rem 0 0.75rem; }
				.tile { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--link); padding: 1rem; margin-bottom: 1rem; }
				fieldset.tile { border: 1px solid var(--border); border-left: 3px solid var(--link); }
				legend { font-weight: 600; padding: 0 0.5rem; }
				label { display: block; margin: 0.75rem 0; }
				label .lbl { display: block; font-size: 0.75rem; color: var(--text-2); margin-bottom: 0.25rem; }
				input[type=text], input[type=password] { width: 100%; font: inherit; padding: 0.5rem; border: 1px solid #8d8d8d; border-radius: 0; background: var(--surface); }
				input[type=text]:focus, input[type=password]:focus { outline: 2px solid var(--link); outline-offset: -2px; border-color: var(--link); }
				.hint { color: var(--text-2); font-size: 0.75rem; display: block; margin-top: 0.25rem; }
				button { font: inherit; cursor: pointer; border: 1px solid transparent; padding: 0.5rem 1rem; }
				button[type=submit] { background: var(--btn); color: #fff; }
				button[type=submit]:hover { background: var(--btn-hover); }
				button[type=button] { background: transparent; border-color: var(--btn); color: var(--btn); padding: 0.25rem 0.75rem; font-size: 0.875rem; }
				button[type=button]:hover { background: var(--btn); color: #fff; }
				.msg { padding: 0.75rem 1rem; margin-bottom: 1rem; border-left: 3px solid; }
				.msg.ok { background: var(--ok-bg); color: var(--ok-fg); border-color: var(--tag-ok); }
				.msg.err { background: var(--err-bg); color: var(--err-fg); border-color: var(--tag-err); }
				.tag { display: inline-block; font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: 0.75rem; background: #e0e0e0; color: var(--text-2); }
				.tag.ok { background: var(--ok-bg); color: var(--ok-fg); }
				.tag.err { background: var(--err-bg); color: var(--err-fg); }
				.dot { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 50%; margin-left: 0.4em; vertical-align: baseline; }
				.dot.ok { background: var(--tag-ok); }
				.dot.err { background: var(--tag-err); }
				table { border-collapse: collapse; width: 100%; background: var(--surface); font-size: 0.875rem; }
				th, td { border-bottom: 1px solid var(--border); padding: 0.5rem 1rem; text-align: left; vertical-align: top; }
				thead th { background: var(--surface); color: var(--text-2); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.02em; }
				tbody tr:hover { background: #f4f4f4; }
				.lede { color: var(--text-2); margin: 0 0 1.5rem; }
				.cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
				@media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
				a.card { display: block; background: var(--surface); border: 1px solid var(--border); border-top: 3px solid var(--link); padding: 1rem; text-decoration: none; color: inherit; }
				a.card:hover { border-color: var(--link); }
				a.card strong { display: block; font-size: 1rem; margin-bottom: 0.25rem; }
				a.card span { color: var(--text-2); font-size: 0.875rem; }
				.e404 { font-size: 4rem; font-weight: 300; color: #8d8d8d; margin: 2rem 0 0; }
				code { font-family: "IBM Plex Mono", ui-monospace, monospace; background: #e0e0e0; padding: 0.125rem 0.375rem; }
				footer { max-width: 768px; margin: 0 auto; padding: 0 1rem 2rem; color: var(--text-2); font-size: 0.75rem; }
			</style>
		</head>
		<body>
			<header class="top">
				<a class="brand" href="/">Hermes Voice</a>
				<nav>
				<a href="/" aria-current={ navState(active, "home") }>home</a>
				<a href="/setup" aria-current={ navState(active, "setup") }>setup</a>
				<a href="/status" aria-current={ navState(active, "status") }>status</a>
				<a href="/firmware" aria-current={ navState(active, "firmware") }>firmware</a>
				</nav>
			</header>
			<main>
				@body
			</main>
			<footer>localhost admin · no login · never exposed to LAN</footer>
		</body>
	</html>
}

func navState(active string, name string) string {
	if active == name {
		return "page"
	}
	return "false"
}
